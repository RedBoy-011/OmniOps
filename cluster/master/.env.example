# OmniOps Enterprise Master Node - Environment Variables
# Generate secure random strings for secrets: openssl rand -hex 32

# Cluster Orchestration Secret Key (Used by Workers & Edge Mirror to authenticate)
CLUSTER_SECRET_KEY=change_me_super_secret_cluster_key_64_chars

# Network Bindings
OMNIOPS_BIND_PORT=8000
OMNIOPS_ENV=production

# PostgreSQL
POSTGRES_DB=omniops
POSTGRES_USER=omniops
POSTGRES_PASSWORD=change_me_postgres_password_random_32

# Redis
REDIS_PASSWORD=change_me_redis_password_random_32

# Qdrant Vector Database
QDRANT_API_KEY=change_me_qdrant_api_key_random_32

# LiteLLM Gateway
LITELLM_MASTER_KEY=sk-omniops-master-key-change-me

# Security & JWT
JWT_SECRET=change_me_jwt_secret_random_64

# External AI Provider Keys (for LiteLLM and Key Pool)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
ANTHROPIC_API_KEY=
