{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniOps Windows Edge",
  "version": "0.1.0",
  "identifier": "com.omniops.windowsedge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "OmniOps Edge",
      "width": 1160,
      "height": 780,
      "minWidth": 340,
      "minHeight": 76,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": false,
      "resizable": true,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
