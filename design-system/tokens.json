{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "OmniOps Unified Design System Tokens",
  "version": "1.0.0",
  "description": "Lightweight shared design system tokens for Web, Windows Edge, and Android/PWA",
  "colors": {
    "brand": {
      "cyan": "#00f0ff",
      "cyanRgb": "0, 240, 255",
      "emerald": "#00ffaa",
      "emeraldRgb": "0, 255, 170",
      "mint": "#5eead4",
      "gradient": "linear-gradient(135deg, #00f0ff 0%, #00ffaa 100%)",
      "gradientHover": "linear-gradient(135deg, #38bdf8 0%, #34d399 100%)"
    },
    "status": {
      "success": "#10b981",
      "successBg": "rgba(16, 185, 129, 0.12)",
      "warning": "#f59e0b",
      "warningBg": "rgba(245, 158, 11, 0.12)",
      "danger": "#ef4444",
      "dangerBg": "rgba(239, 68, 68, 0.12)",
      "info": "#06b6d4",
      "infoBg": "rgba(6, 182, 212, 0.12)"
    },
    "dark": {
      "bgApp": "#0a0f1d",
      "bgSurface": "rgba(15, 23, 42, 0.75)",
      "bgSurfaceActive": "rgba(30, 41, 59, 0.85)",
      "border": "rgba(255, 255, 255, 0.10)",
      "borderHover": "rgba(0, 240, 255, 0.35)",
      "textPrimary": "#f8fafc",
      "textSecondary": "#94a3b8",
      "textMuted": "#64748b"
    },
    "light": {
      "bgApp": "#f8fafc",
      "bgSurface": "rgba(255, 255, 255, 0.85)",
      "bgSurfaceActive": "rgba(241, 245, 249, 0.95)",
      "border": "rgba(15, 23, 42, 0.10)",
      "borderHover": "rgba(13, 148, 136, 0.40)",
      "textPrimary": "#0f172a",
      "textSecondary": "#475569",
      "textMuted": "#94a3b8"
    }
  },
  "glass": {
    "dark": {
      "backdropFilter": "blur(20px) saturate(180%) contrast(105%)",
      "specular": "inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.22)",
      "specularSubtle": "inset 0 1px 1px 0 rgba(255, 255, 255, 0.12)",
      "shadow": "0 20px 50px rgba(0, 0, 0, 0.4), 0 0 30px rgba(0, 240, 255, 0.08)",
      "cardBg": "rgba(15, 23, 42, 0.72)",
      "headerBg": "rgba(10, 15, 29, 0.75)"
    },
    "light": {
      "backdropFilter": "blur(24px) saturate(190%) contrast(100%)",
      "specular": "inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.95)",
      "specularSubtle": "inset 0 1px 1px 0 rgba(255, 255, 255, 0.8)",
      "shadow": "0 18px 45px rgba(15, 23, 42, 0.08), 0 0 25px rgba(13, 148, 136, 0.06)",
      "cardBg": "rgba(255, 255, 255, 0.82)",
      "headerBg": "rgba(255, 255, 255, 0.88)"
    }
  },
  "typography": {
    "fontFamily": "Vazirmatn, 'Segoe UI', -apple-system, BlinkMacSystemFont, Tahoma, sans-serif",
    "fontFamilyMono": "JetBrains Mono, Fira Code, Consolas, monospace",
    "direction": "rtl"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "motion": {
    "transitionFast": "all 0.15s ease",
    "transitionNormal": "all 0.25s ease",
    "transitionSlow": "all 0.4s cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
