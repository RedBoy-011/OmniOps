{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "OmniOps Unified Design System Tokens",
  "version": "2.0.0",
  "description": "Unified Design System Tokens with default Red/Magenta palette for Web, Windows Edge, and Android",
  "defaultPalette": "magenta",
  "palettes": {
    "magenta": {
      "id": "magenta",
      "name": "قرمز / مجنتا مخملی (پیش‌فرض)",
      "primary": "#f43f5e",
      "primaryRgb": "244, 63, 94",
      "primaryHover": "#fb7185",
      "accent": "#d946ef",
      "accentRgb": "217, 70, 239",
      "gradient": "linear-gradient(135deg, #f43f5e 0%, #d946ef 100%)",
      "gradientHover": "linear-gradient(135deg, #fb7185 0%, #e879f9 100%)",
      "bgApp": "#100b15",
      "bgSurface": "rgba(28, 17, 33, 0.78)",
      "bgSurfaceActive": "rgba(45, 25, 52, 0.88)",
      "border": "rgba(244, 63, 94, 0.20)",
      "borderHover": "rgba(244, 63, 94, 0.45)",
      "glow": "0 0 30px rgba(244, 63, 94, 0.22)"
    },
    "cyan": {
      "id": "cyan",
      "name": "سایبرپانک فیروزه‌ای (Cyber Cyan)",
      "primary": "#00f0ff",
      "primaryRgb": "0, 240, 255",
      "primaryHover": "#38bdf8",
      "accent": "#00ffaa",
      "accentRgb": "0, 255, 170",
      "gradient": "linear-gradient(135deg, #00f0ff 0%, #00ffaa 100%)",
      "gradientHover": "linear-gradient(135deg, #38bdf8 0%, #34d399 100%)",
      "bgApp": "#0a0f1d",
      "bgSurface": "rgba(15, 23, 42, 0.75)",
      "bgSurfaceActive": "rgba(30, 41, 59, 0.85)",
      "border": "rgba(0, 240, 255, 0.18)",
      "borderHover": "rgba(0, 240, 255, 0.45)",
      "glow": "0 0 30px rgba(0, 240, 255, 0.20)"
    },
    "emerald": {
      "id": "emerald",
      "name": "زمردی / نعنایی (Emerald Mint)",
      "primary": "#10b981",
      "primaryRgb": "16, 185, 129",
      "primaryHover": "#34d399",
      "accent": "#06b6d4",
      "accentRgb": "6, 182, 212",
      "gradient": "linear-gradient(135deg, #10b981 0%, #06b6d4 100%)",
      "gradientHover": "linear-gradient(135deg, #34d399 0%, #22d3ee 100%)",
      "bgApp": "#061510",
      "bgSurface": "rgba(11, 29, 23, 0.78)",
      "bgSurfaceActive": "rgba(18, 48, 38, 0.88)",
      "border": "rgba(16, 185, 129, 0.20)",
      "borderHover": "rgba(16, 185, 129, 0.45)",
      "glow": "0 0 30px rgba(16, 185, 129, 0.20)"
    },
    "amber": {
      "id": "amber",
      "name": "کهربایی خورشیدی (Solar Amber)",
      "primary": "#f59e0b",
      "primaryRgb": "245, 158, 11",
      "primaryHover": "#fbbf24",
      "accent": "#ef4444",
      "accentRgb": "239, 68, 68",
      "gradient": "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)",
      "gradientHover": "linear-gradient(135deg, #fbbf24 0%, #f87171 100%)",
      "bgApp": "#140e06",
      "bgSurface": "rgba(33, 21, 9, 0.78)",
      "bgSurfaceActive": "rgba(51, 32, 14, 0.88)",
      "border": "rgba(245, 158, 11, 0.20)",
      "borderHover": "rgba(245, 158, 11, 0.45)",
      "glow": "0 0 30px rgba(245, 158, 11, 0.20)"
    },
    "indigo": {
      "id": "indigo",
      "name": "کیهانی لاجوردی (Cosmic Indigo)",
      "primary": "#6366f1",
      "primaryRgb": "99, 102, 241",
      "primaryHover": "#818cf8",
      "accent": "#a855f7",
      "accentRgb": "168, 85, 247",
      "gradient": "linear-gradient(135deg, #6366f1 0%, #a855f7 100%)",
      "gradientHover": "linear-gradient(135deg, #818cf8 0%, #c084fc 100%)",
      "bgApp": "#0b0c1b",
      "bgSurface": "rgba(19, 21, 46, 0.78)",
      "bgSurfaceActive": "rgba(30, 34, 73, 0.88)",
      "border": "rgba(99, 102, 241, 0.20)",
      "borderHover": "rgba(99, 102, 241, 0.45)",
      "glow": "0 0 30px rgba(99, 102, 241, 0.20)"
    }
  },
  "status": {
    "success": "#10b981",
    "successBg": "rgba(16, 185, 129, 0.12)",
    "warning": "#f59e0b",
    "warningBg": "rgba(245, 158, 11, 0.12)",
    "danger": "#ef4444",
    "dangerBg": "rgba(239, 68, 68, 0.12)",
    "info": "#06b6d4",
    "infoBg": "rgba(6, 182, 212, 0.12)"
  },
  "typography": {
    "fontFamily": "Vazirmatn, 'Segoe UI', -apple-system, BlinkMacSystemFont, Tahoma, sans-serif",
    "fontFamilyMono": "'JetBrains Mono', Fira Code, Consolas, monospace",
    "direction": "rtl"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "motion": {
    "transitionFast": "all 0.15s ease",
    "transitionNormal": "all 0.25s ease",
    "transitionSlow": "all 0.4s cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
